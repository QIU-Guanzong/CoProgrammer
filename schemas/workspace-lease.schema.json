{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coprogrammer.dev/schemas/workspace-lease.schema.json",
  "title": "CoProgrammer Workspace Lease",
  "type": "object",
  "required": ["id", "holder", "scope", "status", "created_at"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "holder": { "type": "string" },
    "task": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["kind", "patterns"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["path", "contract", "test_surface", "integration_branch"]
        },
        "patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["requested", "active", "released", "expired", "denied"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
