{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coprogrammer.dev/schemas/coprogrammer-config.schema.json",
  "title": "CoProgrammer Project Config",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "language": {
      "type": "string",
      "enum": ["en", "en-US", "zh", "zh-CN", "zh_CN", "cn"]
    },
    "risk_level_by_category": {
      "type": "object",
      "properties": {
        "contract": { "$ref": "#/$defs/riskLevel" },
        "database": { "$ref": "#/$defs/riskLevel" },
        "security": { "$ref": "#/$defs/riskLevel" },
        "build": { "$ref": "#/$defs/riskLevel" },
        "architecture": { "$ref": "#/$defs/riskLevel" }
      },
      "additionalProperties": false
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "risk": { "$ref": "#/$defs/riskLevel" },
          "reason": { "type": "string" },
          "owner_review": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "model_routing": {
      "type": "object",
      "properties": {
        "simple_work_model": { "type": "string", "minLength": 1 },
        "default_model": { "type": "string" },
        "high_risk_model": { "type": "string" },
        "simple_work_allowed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires_human_review": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    }
  }
}
