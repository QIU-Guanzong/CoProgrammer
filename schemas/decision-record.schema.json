{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coprogrammer.dev/schemas/decision-record.schema.json",
  "title": "CoProgrammer Decision Record",
  "type": "object",
  "required": ["id", "question", "status", "created_at"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "question": { "type": "string" },
    "context": { "type": "string" },
    "options": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decision": { "type": "string" },
    "decider": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["open", "decided", "deferred", "rejected", "superseded"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "unknown"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "decided_at": { "type": "string", "format": "date-time" },
    "related_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
