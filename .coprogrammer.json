{
  "$schema": "./schemas/coprogrammer-config.schema.json",
  "language": "zh-CN",
  "risk_level_by_category": {
    "contract": "medium",
    "database": "high",
    "security": "high",
    "build": "medium",
    "architecture": "medium"
  },
  "model_routing": {
    "simple_work_model": "codex-5.3",
    "default_model": "codex-default",
    "high_risk_model": "maintainer-approved",
    "simple_work_allowed": [
      "documentation polish",
      "research lead triage",
      "low-risk template updates",
      "format-only changes",
      "local validation and summaries"
    ],
    "requires_human_review": [
      "schemas/**",
      "protocols/**",
      "security/auth/payment behavior",
      "database migrations",
      "integration patch application"
    ]
  },
  "protected_paths": [
    {
      "pattern": "AGENTS.md",
      "risk": "medium",
      "reason": "repository agent instructions affect all coding agents",
      "owner_review": false
    },
    {
      "pattern": "protocols/**",
      "risk": "high",
      "reason": "collaboration protocol changes affect all agents",
      "owner_review": true
    },
    {
      "pattern": "schemas/**",
      "risk": "high",
      "reason": "machine-readable artifact contract changes",
      "owner_review": true
    },
    {
      "pattern": "research/**",
      "risk": "medium",
      "reason": "structured research data changes",
      "owner_review": false
    },
    {
      "pattern": ".github/workflows/**",
      "risk": "high",
      "reason": "CI and automation behavior changes",
      "owner_review": true
    },
    {
      "pattern": ".github/DISCUSSION_TEMPLATE/**",
      "risk": "medium",
      "reason": "community discussion intake behavior",
      "owner_review": false
    },
    {
      "pattern": ".github/ISSUE_TEMPLATE/**",
      "risk": "medium",
      "reason": "issue intake and triage behavior",
      "owner_review": false
    },
    {
      "pattern": "src/coprogrammer/cli.py",
      "risk": "medium",
      "reason": "CLI behavior affects PR digest generation",
      "owner_review": false
    },
    {
      "pattern": "templates/AGENTS.md",
      "risk": "medium",
      "reason": "agent instruction template affects downstream repository setup",
      "owner_review": false
    },
    {
      "pattern": "pyproject.toml",
      "risk": "medium",
      "reason": "package and entrypoint configuration",
      "owner_review": true
    }
  ]
}
